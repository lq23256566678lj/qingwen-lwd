                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "content": [
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "查找"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Ctrl + F"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "⌘ + F"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "tableRow",
            "content": [
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "高亮"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "Ctrl + Shift + H"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableCell",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
                    "content": [
                      {
                        "type": "text",
                        "text": "⌘ + ⇧ + H"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "代码与图片"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "代码块使用等宽字体，适合记录片段："
          }
        ]
      },
      {
        "type": "codeBlock",
        "content": [
          {
            "type": "text",
            "text": "{\n  \"format\": \"lwd\",\n  \"version\": 1,\n  \"app\": \"qingwen-lwd\"\n}"
          }
        ]
      },
      {
        "type": "image",
        "attrs": {
          "src": "data:image/png;base64,",
          "alt": "轻文图标",
          "title": "轻文",
          "width": 112,
          "height": 112
        }
      },
      {
        "type": "paragraph",
        "attrs": {
          "textAlign": "center"
        },
        "content": [
          {
            "type": "text",
            "text": "所有图片都会随文档一起保存。",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "color": "#8b95a7",
                  "fontSize": "12px"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "开始写作"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "点击工具栏的「打开」载入这个示例，或直接在这里继续输入。按 "
          },
          {
            "type": "text",
            "text": "Ctrl/⌘ + F",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": " 可以搜索全文中英文内容，"
          },
          {
            "type": "text",
            "text": "JSON",
            "marks": [
              {
                "type": "link",
                "attrs": {
                  "href": "https://www.json.org/json-zh.html"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": " 是一个轻量的数据交换格式。"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "提示：轻文不会在应用内打开链接，避免 WebView 导航风险。",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "color": "#8b95a7",
                  "fontSize": "12px"
                }
              }
            ]
          }
        ]
      }
    ]
  }
