                        "text": "Windows / Linux"
                      }
                    ]
                  }
                ]
              },
              {
                "type": "tableHeader",
                "attrs": {
                  "colspan": 1,
                  "rowspan": 1,
                  "colwidth": null
                },
                "content": [
                  {
                    "type": "paragraph",
