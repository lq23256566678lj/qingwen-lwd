  },
  "document": {
    "type": "doc",
    "content": [
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "轻文 LWD"
          }
        ]
      },
      {
        "type": "paragraph",
        "attrs": {
          "textAlign": "left"
        },
        "content": [
          {
            "type": "text",
            "text": "一个只做写作的轻量级富文本编辑器。"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "轻文使用自包含的 "
          },
          {
            "type": "text",
            "text": ".lwd",
            "marks": [
              {
                "type": "code"
              }
            ]
          },
          {
            "type": "text",
            "text": " JSON 文档保存内容，支持 "
          },
          {
            "type": "text",
            "text": "加粗",
            "marks": [
              {
                "type": "bold"
              }
            ]
          },
          {
            "type": "text",
            "text": "、"
          },
          {
            "type": "text",
            "text": "斜体",
            "marks": [
              {
                "type": "italic"
              }
            ]
          },
          {
            "type": "text",
            "text": "、"
          },
          {
            "type": "text",
            "text": "下划线",
            "marks": [
              {
                "type": "underline"
              }
            ]
          },
          {
            "type": "text",
            "text": "、"
          },
          {
            "type": "text",
            "text": "删除线",
            "marks": [
              {
                "type": "strike"
              }
            ]
          },
          {
            "type": "text",
            "text": "、"
          },
          {
            "type": "text",
            "text": "高亮",
            "marks": [
              {
                "type": "highlight",
                "attrs": {
                  "color": "#fff3a3"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "、"
          },
          {
            "type": "text",
            "text": "彩色文字",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "color": "#b42318"
                }
              }
            ]
          },
          {
            "type": "text",
            "text": "、表格、图片与查找替换。所有图片内嵌在文档里，拷贝一个文件就能带走全部内容。"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "为什么是 .lwd？"
          }
        ]
      },
      {
        "type": "bulletList",
        "content": [
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "纯 JSON：结构可读，便于版本管理与二次开发。"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "自包含：图片以 data URL 内嵌，不依赖外部资源目录。"
                  }
                ]
              }
            ]
          },
          {
            "type": "listItem",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "版本化：format / version / app 字段让迁移有据可依。"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "blockquote",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "写作工具应该消失在手感里，而不是出现在菜单里。"
              },
              {
                "type": "text",
                "text": " —— 轻文设计原则"
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "常用快捷键"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "下表以 Windows / Linux 为例；macOS 将 Ctrl 替换为 ⌘。",
            "marks": [
              {
                "type": "textStyle",
                "attrs": {
                  "color": "#6b7280"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "table",
        "content": [
          {
            "type": "tableRow",
            "content": [
              {
                "type": "tableHeader",
                "attrs": {
                  "colspan": 1,
